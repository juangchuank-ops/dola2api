# Dola2API 环境变量
#
# 安装到 /etc/dola2api/env，权限 600、属主 root：
#
#   sudo install -m 600 -o root -g root deploy/env.example /etc/dola2api/env
#   sudo sed -i 's/change-me/你的密码/' /etc/dola2api/env
#
# 格式是 systemd 的 EnvironmentFile：每行 KEY=VALUE，不要写 export，
# 值里含空格或特殊字符时用双引号包起来。
#
# 这些变量都可以被同名命令行参数覆盖（-addr / -data / -static /
# -admin-user / -admin-password），参数的优先级更高。

# ── 必填 ─────────────────────────────────────────────────────────────

# 首次启动时写入的管理员密码。
#
# 只在数据文件里还没有密码时生效。一旦启动过一次，改这里就没用了——
# 之后改密码请走管理台「系统设置」，那条路径会同时撤销所有已签发的会话。
DOLA2API_ADMIN_PASSWORD=change-me

# ── 可选（都有默认值）────────────────────────────────────────────────

# 监听地址。默认 127.0.0.1:8080。
#
# 保持只监听本地，让 Nginx 对外，是更安全的做法：管理台能读账号 Cookie
# 的掩码、改上游地址、签发客户端密钥，不该直接暴露。
# 确实需要程序直接对外时改成 0.0.0.0:8080，但请自行加访问控制。
#DOLA2API_ADDR=127.0.0.1:8080

# 数据目录，默认 data（相对工作目录）。
#
# 账号 Cookie、客户端密钥、审计记录、生成媒体全在这里。这是唯一需要备份
# 的目录，也是唯一需要写权限的目录。
#DOLA2API_DATA=/opt/dola2api/data

# 前端产物目录，默认 frontend/dist。不存在时只提供 API，控制台不可用。
#DOLA2API_STATIC=/opt/dola2api/frontend/dist

# 初始管理员用户名，默认 admin。同样只在首次启动时使用。
#DOLA2API_ADMIN_USER=admin
